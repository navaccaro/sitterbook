generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RegistrationRequest {
  id                   String   @id
  name                 String
  email                String   @unique
  provider             String
  status               String
  primaryContactName   String   @default("")
  primaryPhone         String   @default("")
  secondaryContactName String   @default("")
  secondaryPhone       String   @default("")
  addressLine1         String   @default("")
  addressLine2         String   @default("")
  city                 String   @default("")
  state                String   @default("")
  postalCode           String   @default("")
  additionalInfo       String   @default("")
  requestedAt          DateTime
}

model AvailabilityBlock {
  id       String   @id
  sitterId String
  start    DateTime
  end      DateTime
  status   String
  label    String
}

model Booking {
  id             String   @id
  availabilityId String
  parentId       String
  sitterId       String
  start          DateTime
  end            DateTime
  status         String
  parentName     String
  notes          String   @default("")
  googleEventId  String?
}

model User {
  id                 String  @id
  name               String
  email              String   @unique
  role               String
  approved           Boolean
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleCalendarId   String?
}

model Session {
  token     String   @id
  userId    String
  name      String
  email     String
  createdAt DateTime
  expiresAt DateTime

  @@index([email])
}

// A sitter and a parent must both consent (via invite or approved request) before they can see or book each other.
model Connection {
  id          String    @id
  sitterId    String
  parentId    String
  status      String
  createdAt   DateTime
  respondedAt DateTime?

  @@unique([sitterId, parentId])
  @@index([parentId])
}

model Invite {
  token     String    @id
  sitterId  String
  createdAt DateTime
  revokedAt DateTime?

  @@index([sitterId])
}
